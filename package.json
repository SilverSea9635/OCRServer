{
  "name": "ocr-server",
  "version": "0.0.1",
  "description": "OCR HTTP API server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs --env production",
    "start:direct": "node server.js",
    "dev": "nodemon server.js --mode development",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop snap-ui-server",
    "pm2:delete": "pm2 delete snap-ui-server",
    "pm2:logs": "pm2 logs snap-ui-server",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "test": "node --test"
  },
  "author": "CodeGod",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.1",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "nodemon": "^3.1.14"
  }
}
